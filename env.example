# ============================================================================
# comidas-plataforma — variables de entorno
# ============================================================================
#
# Este fichero es una plantilla. En tu laptop copia a `.env` y rellena con
# los valores reales (el `.env` está gitignored). En producción NO uses este
# fichero: las env vars se configuran en el panel Coolify del servicio.
#
# Ver docs/despliegue/ARQUITECTURA-ENTORNOS.md para la arquitectura.

# ----- Base de datos ---------------------------------------------------------
#
# DEV (laptop) — apunta a `comidas_dev` en Hetzner con el usuario dev.
# El usuario `comidas_dev_user` solo tiene permisos sobre `comidas_dev`, así
# que un copy-paste malo no puede escribir en prod.
DATABASE_URL="postgresql://comidas_dev_user:REEMPLAZAR@<host-bd>:5432/comidas_dev?schema=public"
#
# PROD — NO configurar en este fichero. Va en el panel Coolify → service
# comidas → Environment Variables. Ejemplo (no real):
# DATABASE_URL="postgresql://comidas_prod_user:***@<internal-host>:5432/comidas_prod?schema=public"

# ----- NextAuth --------------------------------------------------------------
#
# Genera con: openssl rand -base64 32
# Dev y prod DEBEN tener secretos distintos.
NEXTAUTH_SECRET="genera-con-openssl-y-pega-aqui"
NEXTAUTH_URL="http://localhost:3000"

# ----- Cifrado PII (Sprint 4) ------------------------------------------------
#
# 32 bytes hex (64 chars). Genera con: openssl rand -hex 32
# Se usa para cifrar nameEnc / phoneEnc en la BD. Si alguna vez la rotas,
# los datos antiguos se vuelven ilegibles — planifica migración.
PII_ENCRYPTION_KEY="genera-con-openssl-rand-hex-32-sin-commitearlo"

# ----- Rate limiting (Sprint 4, opcional) ------------------------------------
#
# El limiter por defecto es in-memory (válido para una sola instancia). Para
# producción con varias replicas, descomentar y usar Upstash Redis.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# ----- Tenant Configuration --------------------------------------------------
#
# Dominio wildcard para routing multi-tenant por subdominio.
WILDCARD_DOMAIN=".localhost:3000"
# En producción: WILDCARD_DOMAIN=".plati.es"

# ----- Seguridad -------------------------------------------------------------
#
# Cerrojo de aislamiento por tenant (F5). Con "true", el guard de Prisma BLOQUEA
# (lanza) las LECTURAS de lista/agregado (findMany/findFirst/count/aggregate/
# groupBy) sobre modelos multi-tenant que no lleven filtro de tenant. Con "false"
# (o sin definir) solo AVISA en logs. Las lecturas cross-tenant del panel admin
# usan un cliente sin guard (lib/db/prisma-admin.ts).
# Recomendado: activar primero en DEV, recorrer los 4 portales + admin y corregir
# lo que salte, y solo después ponerlo en prod. Fail-safe: si algo se escapa,
# esa vista da error (no hay fuga de datos).
TENANT_GUARD_ENFORCE="false"

# ----- Feature Flags ---------------------------------------------------------
FEATURE_AI_NUTRITION="false"
FEATURE_AUTO_SELECTION="false"
FEATURE_GAMIFICATION="false"

# ----- Límites del Sistema ---------------------------------------------------
DEFAULT_DAILY_LIMIT="11.00"       # € por empleado/día (exención IRPF)
DEFAULT_CUTOFF_TIME="11:00"        # HH:mm, hora de cierre de pedidos
DEFAULT_TAX_RATE_FOOD="10"         # IVA hostelería %
DEFAULT_TAX_RATE_SERVICE="21"      # IVA servicios %

# ----- Cron Jobs -------------------------------------------------------------
ENABLE_CRON_JOBS="false"

# ----- Email (opcional para MVP) ---------------------------------------------
# SMTP_HOST="smtp.ejemplo.com"
# SMTP_PORT="587"
# SMTP_USER="tu-usuario"
# SMTP_PASSWORD="tu-contraseña"
# SMTP_FROM="noreply@plati.es"

# ----- Storage (opcional para MVP) -------------------------------------------
# S3_BUCKET="comidas-storage"
# S3_REGION="eu-west-1"
# S3_ACCESS_KEY="tu-access-key"
# S3_SECRET_KEY="tu-secret-key"

# ----- Monitoring (opcional) -------------------------------------------------
# SENTRY_DSN="https://..."

# ----- Email (Resend) --------------------------------------------------------
#
# Necesario para enviar emails (restablecimiento de contraseña, etc.). Sin
# RESEND_API_KEY la app NO rompe: registra un aviso y no envía (modo dev).
# 1) Crea cuenta en https://resend.com y verifica el dominio (plati.es).
# 2) Genera una API key y ponla aquí (dev) y en Coolify (prod).
RESEND_API_KEY=""                              # ej. re_xxxxxxxx
EMAIL_FROM="Plati <no-reply@plati.es>"         # remitente verificado en Resend
# URL pública para construir enlaces en emails (si falta, usa NEXTAUTH_URL).
NEXT_PUBLIC_APP_URL="http://localhost:3000"    # en prod: https://www.plati.es

# ----- Logging ---------------------------------------------------------------
LOG_LEVEL="debug"                  # En producción: info
NODE_ENV="development"             # En producción: production
