# Database
# Conexión a PostgreSQL
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/comidas_dev?schema=public"

# NextAuth
# Genera con: openssl rand -base64 32
NEXTAUTH_SECRET="tu-secret-aqui-generar-con-openssl"
NEXTAUTH_URL="http://localhost:3000"

# Tenant Configuration
# Dominio wildcard para multi-tenancy
WILDCARD_DOMAIN=".sintupper.localhost"
# En producción: WILDCARD_DOMAIN=".sintupper.com"

# Feature Flags
# IA de nutrición (MVP: desactivado)
FEATURE_AI_NUTRITION="false"
# Auto-selección de menús (MVP: desactivado)
FEATURE_AUTO_SELECTION="false"
# Gamificación (MVP: desactivado)
FEATURE_GAMIFICATION="false"

# Límites del Sistema
# Límite fiscal por defecto (en euros)
DEFAULT_DAILY_LIMIT="11.00"
# Hora de corte por defecto (formato HH:mm)
DEFAULT_CUTOFF_TIME="11:00"
# IVA hostelería (%)
DEFAULT_TAX_RATE_FOOD="10"
# IVA servicios (%)
DEFAULT_TAX_RATE_SERVICE="21"

# Cron Jobs
# Habilitar cron jobs (desactivar en desarrollo si no es necesario)
ENABLE_CRON_JOBS="false"

# Email (opcional para MVP)
# SMTP_HOST="smtp.ejemplo.com"
# SMTP_PORT="587"
# SMTP_USER="tu-usuario"
# SMTP_PASSWORD="tu-contraseña"
# SMTP_FROM="noreply@sintupper.com"

# Storage (opcional para MVP)
# Para almacenar documentos, facturas, etc.
# S3_BUCKET="comidas-storage"
# S3_REGION="eu-west-1"
# S3_ACCESS_KEY="tu-access-key"
# S3_SECRET_KEY="tu-secret-key"

# Monitoring (opcional)
# SENTRY_DSN="https://..."
# VERCEL_ENV="development"

# Redis (opcional para cache)
# REDIS_URL="redis://localhost:6379"

# Logging
LOG_LEVEL="debug"
# En producción: LOG_LEVEL="info"

