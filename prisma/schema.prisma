enum HolidayScope {
  NATIONAL
  REGION
  TENANT

  @@map("holiday_scope")
}

/// Festivos. 3 scopes: NATIONAL (todo ES), REGION (ES-MD, ES-CN, …),
/// TENANT (festivo propio del tenant).
model Holiday {
  id          String       @id @default(uuid())
  date        DateTime     @db.Date
  name        String
  scope       HolidayScope
  regionCode  String?      @map("region_code")
  tenantId    String?      @map("tenant_id")
  description String?
  createdBy   String?      @map("created_by")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([date])
  @@index([scope, regionCode])
  @@index([tenantId])
  @@map("holidays")
}

/// Override de un tenant sobre un festivo oficial (NATIONAL/REGION).
/// Su presencia desactiva ese festivo para ese tenant.
model HolidayOverride {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  holidayId String   @map("holiday_id")
  disabled  Boolean  @default(true)
  notes     String?
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tenantId, holidayId])
  @@index([tenantId])
  @@map("holiday_overrides")
}

/// Zona de reparto de un catering. Normaliza el JSON Restaurant.zones.
model DeliveryZone {
  id             String   @id @default(uuid())
  tenantCatering String   @map("tenant_catering")
  name           String
  postalCodes    String[] @map("postal_codes")
  maxDistanceKm  Int?     @map("max_distance_km")
  defaultDriver  String?  @map("default_driver")
  notes          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([tenantCatering, active])
  @@map("delivery_zones")
}

enum IncidentReasonSeverity {
  LOW
  MEDIUM
  HIGH

  @@map("incident_reason_severity")
}

/// Catálogo editable de motivos de incidencia.
model IncidentReason {
  id                   String                 @id @default(uuid())
  code                 String                 @unique
  name                 String
  description          String?
  defaultSeverity      IncidentReasonSeverity @default(MEDIUM) @map("default_severity")
  category             String
  requiresCompensation Boolean                @default(false) @map("requires_compensation")
  scope                String                 @default("SYSTEM")
  tenantId             String?                @map("tenant_id")
  active               Boolean                @default(true)
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  incidents Incident[]

  @@index([scope, active])
  @@index([tenantId])
  @@map("incident_reasons")
}

/// Configuración global de branding del sistema. Sólo debe haber una fila.
/// Cuando un tenant no personaliza su branding, los portales caen en estos
/// valores por defecto. El super admin puede editarlos desde
/// /admin/templates/branding. Singleton pattern: id fijo.
model SystemSettings {
  id                    String   @id @default("singleton")
  defaultPrimaryColor   String   @default("#E0492A") @map("default_primary_color")
  defaultSecondaryColor String?  @map("default_secondary_color")
  defaultLogoUrl        String?  @map("default_logo_url")
  defaultFaviconUrl     String?  @map("default_favicon_url")
  brandName             String   @default("Plati")
  updatedBy             String?  @map("updated_by")
  updatedAt             DateTime @updatedAt @map("updated_at")
  createdAt             DateTime @default(now()) @map("created_at")

  @@map("system_settings")
}

/// Reglas fiscales (IVA) configurables. Sustituye el valor hardcoded
/// 10% en Invoice.taxRate cuando el flujo lo consulte.
model TaxRule {
  id        String    @id @default(uuid())
  code      String    @unique // IVA_GENERAL, IVA_COMIDA, IGIC_CANARIAS, ...
  name      String
  rate      Decimal   @db.Decimal(5, 2) // 10.00, 21.00, 7.00
  category  String // food / service / digital
  region    String? // ES-CN Canarias, ES-CE Ceuta, ...
  validFrom DateTime  @map("valid_from")
  validTo   DateTime? @map("valid_to")
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([category])
  @@index([active])
  @@map("tax_rules")
}
