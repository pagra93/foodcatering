// ─── Facturación (Sprint 4) ────────────────────────────────────────────

/// Catálogo de planes SaaS que Plati ofrece a las empresas.
/// `Company.plan` (enum existente) referencia este catálogo por `code`.
/// El precio es lo que la empresa paga mensualmente como suscripción SaaS,
/// separado de la factura que el catering le emite por los pedidos.
model SaasPlan {
  id             String      @id @default(uuid())
  code           CompanyPlan @unique
  name           String
  description    String?
  monthlyPrice   Decimal     @db.Decimal(10, 2) @map("monthly_price")
  yearlyPrice    Decimal?    @db.Decimal(10, 2) @map("yearly_price")
  features       Json        @default("[]") // [{name, included, limit?}]
  maxEmployees   Int?        @map("max_employees")
  maxOrdersMonth Int?        @map("max_orders_month")
  supportLevel   String      @default("BASIC") @map("support_level") // BASIC / PRIORITY / DEDICATED
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@map("saas_plans")
}

enum SettlementStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED

  @@map("settlement_status")
}

/// Liquidación mensual de comisión Catering → Plati.
/// Se genera el día 1 de cada mes automáticamente (cron) para el mes
/// anterior. El catering paga por transferencia; Plati marca como
/// PAID al recibirlo.
model Settlement {
  id               String           @id @default(uuid())
  tenantCatering   String           @map("tenant_catering")
  period           String // "YYYY-MM" del mes liquidado
  grossAmount      Decimal          @db.Decimal(10, 2) @map("gross_amount") // sum Invoice.total del mes
  commissionRate   Decimal          @db.Decimal(5, 4) @map("commission_rate") // 0.0500 = 5%
  commissionAmount Decimal          @db.Decimal(10, 2) @map("commission_amount")
  penalties        Decimal          @default(0) @db.Decimal(10, 2) // Penalty APPLIED del mes
  netOwed          Decimal          @db.Decimal(10, 2) @map("net_owed") // lo que el catering paga
  status           SettlementStatus @default(DRAFT)
  issuedAt         DateTime?        @map("issued_at")
  dueBy            DateTime?        @map("due_by")
  paidAt           DateTime?        @map("paid_at")
  paymentRef       String?          @map("payment_ref") // referencia de la transferencia
  notes            String?
  integrityHash    String?          @map("integrity_hash")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@unique([tenantCatering, period])
  @@index([status])
  @@index([dueBy])
  @@map("settlements")
}

enum SaasInvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED

  @@map("saas_invoice_status")
}

/// Factura SaaS mensual emitida por Plati a una empresa por su plan.
/// Flujo independiente de las facturas que recibe del catering.
model SaasInvoice {
  id            String            @id @default(uuid())
  tenantEmpresa String            @map("tenant_empresa")
  period        String // "YYYY-MM"
  planCode      CompanyPlan       @map("plan_code")
  planName      String            @map("plan_name") // snapshot del nombre al emitir
  number        String // correlativo tipo SAAS-2026-0001
  subtotal      Decimal           @db.Decimal(10, 2)
  taxRate       Decimal           @db.Decimal(5, 2) @map("tax_rate")
  taxAmount     Decimal           @db.Decimal(10, 2) @map("tax_amount")
  total         Decimal           @db.Decimal(10, 2)
  status        SaasInvoiceStatus @default(DRAFT)
  issuedAt      DateTime?         @map("issued_at")
  dueBy         DateTime?         @map("due_by")
  paidAt        DateTime?         @map("paid_at")
  paymentMethod String?           @map("payment_method")
  paymentRef    String?           @map("payment_ref")
  notes         String?
  integrityHash String?           @map("integrity_hash")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@unique([tenantEmpresa, period])
  @@unique([number])
  @@index([status])
  @@index([dueBy])
  @@map("saas_invoices")
}

// ─── Operación (Sprint 5) ──────────────────────────────────────────────

/// Registro de backups de la base de datos productiva.
/// El cron nocturno (`scripts/backup-prod.sh`) debería escribir una fila
/// aquí tras cada pg_dump. La UI /admin/operations/backups lo lista para
/// que SUPER_ADMIN vea el estado sin necesitar acceso SSH al servidor.
model BackupEvent {
  id        String   @id @default(uuid())
  fileName  String   @map("file_name")
  fileSize  BigInt?  @map("file_size")
  hash      String?
  createdBy String   @map("created_by")
  source    String   @default("cron")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("backup_events")
}

/// Ventana de mantenimiento programada. Durante la ventana, el
/// middleware devuelve 503 con mensaje custom a todos los usuarios
/// cuyo rol no esté en `allowedRoles`. SUPER_ADMIN siempre pasa.
model MaintenanceWindow {
  id           String    @id @default(uuid())
  startsAt     DateTime  @map("starts_at")
  endsAt       DateTime  @map("ends_at")
  reason       String
  message      String
  allowedRoles Json      @default("[\"SUPER_ADMIN\"]") @map("allowed_roles")
  enabledBy    String    @map("enabled_by")
  disabledAt   DateTime? @map("disabled_at")
  disabledBy   String?   @map("disabled_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([startsAt, endsAt])
  @@index([disabledAt])
  @@map("maintenance_windows")
}

