  SOYBEANS
  MILK
  TREE_NUTS
  CELERY
  MUSTARD
  SESAME
  SULPHITES
  LUPIN
  MOLLUSCS
  OTHER

  @@map("allergen_category")
}

/// Catálogo de alérgenos. Los 14 oficiales EU se siembran como category
/// concreta; un super admin puede añadir extras con category=OTHER.
model Allergen {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  category    AllergenCategory
  description String?
  icon        String?
  active      Boolean          @default(true)
